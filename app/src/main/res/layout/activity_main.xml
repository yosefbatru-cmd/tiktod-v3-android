<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TIKTOD V3"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="idle"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO URL"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_url"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODE"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/mode_views" android:layout_width="wrap_content" android:layout_height="36dp" android:text="@string/mode_views" android:textSize="12sp" android:textAllCaps="false" android:background="@drawable/bg_chip" android:textColor="@color/text" android:paddingHorizontal="14dp" android:layout_marginEnd="8dp" android:minWidth="0" android:minHeight="0"/>
                <Button android:id="@+id/mode_hearts" android:layout_width="wrap_content" android:layout_height="36dp" android:text="@string/mode_hearts" android:textSize="12sp" android:textAllCaps="false" android:background="@drawable/bg_chip" android:textColor="@color/text_dim" android:paddingHorizontal="14dp" android:layout_marginEnd="8dp" android:minWidth="0" android:minHeight="0"/>
                <Button android:id="@+id/mode_shares" android:layout_width="wrap_content" android:layout_height="36dp" android:text="@string/mode_shares" android:textSize="12sp" android:textAllCaps="false" android:background="@drawable/bg_chip" android:textColor="@color/text_dim" android:paddingHorizontal="14dp" android:layout_marginEnd="8dp" android:minWidth="0" android:minHeight="0"/>
                <Button android:id="@+id/mode_favorites" android:layout_width="wrap_content" android:layout_height="36dp" android:text="@string/mode_favorites" android:textSize="12sp" android:textAllCaps="false" android:background="@drawable/bg_chip" android:textColor="@color/text_dim" android:paddingHorizontal="14dp" android:layout_marginEnd="8dp" android:minWidth="0" android:minHeight="0"/>
                <Button android:id="@+id/mode_followers" android:layout_width="wrap_content" android:layout_height="36dp" android:text="@string/mode_followers" android:textSize="12sp" android:textAllCaps="false" android:background="@drawable/bg_chip" android:textColor="@color/text_dim" android:paddingHorizontal="14dp" android:minWidth="0" android:minHeight="0"/>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET" android:textColor="@color/text_muted" android:textSize="11sp" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/count_input" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:hint="@string/hint_target" android:text="5000" android:textColorHint="@color/text_muted" android:textColor="@color/text" android:textSize="14sp" android:paddingHorizontal="14dp" android:inputType="number" android:singleLine="true"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THREADS" android:textColor="@color/text_muted" android:textSize="11sp" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/threads_input" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:hint="@string/hint_threads" android:text="16" android:textColorHint="@color/text_muted" android:textColor="@color/text" android:textSize="14sp" android:paddingHorizontal="14dp" android:inputType="number" android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/delay_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DELAY  80-200 ms" android:textColor="@color/text_muted" android:textSize="11sp" android:letterSpacing="0.08" android:layout_marginBottom="4dp"/>

        <SeekBar android:id="@+id/delay_seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="400" android:progress="140" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
            <Button android:id="@+id/mode_direct_btn" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Direct" android:textAllCaps="false" android:textSize="13sp" android:background="@drawable/bg_chip" android:textColor="@color/text" android:layout_marginEnd="6dp" android:minHeight="0"/>
            <Button android:id="@+id/mode_proxy_btn" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Proxy" android:textAllCaps="false" android:textSize="13sp" android:background="@drawable/bg_chip" android:textColor="@color/text_dim" android:layout_marginStart="6dp" android:minHeight="0"/>
        </LinearLayout>

        <TextView android:id="@+id/proxy_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROXIES" android:textColor="@color/text_muted" android:textSize="11sp" android:letterSpacing="0.08" android:layout_marginBottom="6dp" android:visibility="gone"/>

        <EditText android:id="@+id/proxy_input" android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_input" android:hint="@string/hint_proxy" android:textColorHint="@color/text_muted" android:textColor="@color/text" android:textSize="12sp" android:padding="12dp" android:gravity="top|start" android:inputType="textMultiLine" android:visibility="gone" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/sent_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0 / 0" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/rps_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 rps" android:textColor="@color/accent" android:textSize="14sp" android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/fail_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ok 0%" android:textColor="@color/text_dim" android:textSize="14sp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="0" android:progressTint="@color/accent" android:progressBackgroundTint="@color/border" android:visibility="gone"/>
            <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ready" android:textColor="@color/text_dim" android:textSize="12sp" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
            <Button android:id="@+id/start_btn" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/btn_start" android:textAllCaps="true" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/bg_btn_start" android:textColor="@android:color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/stop_btn" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/btn_stop" android:textAllCaps="true" android:textSize="15sp" android:background="@drawable/bg_btn_stop" android:textColor="@color/accent" android:layout_marginStart="8dp" android:enabled="false"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOG" android:textColor="@color/text_muted" android:textSize="11sp" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>

        <TextView android:id="@+id/log_console" android:layout_width="match_parent" android:layout_height="160dp" android:background="@drawable/bg_card" android:padding="12dp" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:gravity="top|start" android:scrollbars="vertical"/>

    </LinearLayout>
</ScrollView>
